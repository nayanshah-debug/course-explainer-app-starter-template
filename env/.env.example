# Copy this file to env/.env and fill in your values
# Never commit env/.env to git

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-string

# Data provider: yfinance | alphavantage | polygon
DATA_PROVIDER=yfinance

# Schwab (https://developer.schwab.com — create an app, get API key + secret)
# After filling these in, run:  python scripts/schwab_auth.py
SCHWAB_API_KEY=
SCHWAB_API_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Leave blank to use default (env/schwab_token.json)
SCHWAB_TOKEN_PATH=

# Robinhood (for one-click buy from scan results)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# Alpha Vantage (free tier: 25 req/day — https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Polygon.io (paid — https://polygon.io/dashboard/api-keys)
POLYGON_API_KEY=

# Optional: Redis cache URL (leave blank to use in-memory cache)
REDIS_URL=

# Scan settings
SCAN_CONCURRENCY=10
CACHE_TTL_SECONDS=300
